# App Configuration
PROJECT_NAME="RecruitFlow"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretrecruitflowproductionjwtkeychangeinproduction"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL with fallback)
DATABASE_URL="postgresql://postgres:root@localhost:5432/recruitflow"
# For SQLite testing: DATABASE_URL="sqlite:///./recruitflow.db"

# Storage Configuration (MinIO / S3 / Local)
STORAGE_TYPE="local" # 'minio', 's3', or 'local'
STORAGE_LOCAL_DIR="uploads"
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_SECURE=False
MINIO_BUCKET="recruitflow-documents"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
USE_REDIS=False

# Initial Super Admin Seed
INITIAL_SUPERADMIN_EMAIL="admin@recruitflow.com"
INITIAL_SUPERADMIN_PASSWORD="AdminPassword123!"
